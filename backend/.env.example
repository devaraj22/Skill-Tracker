# Copy to .env (never commit .env).
APP_ENV=development            # development | production
DATABASE_URL=postgresql+psycopg://skilltrack:CHANGE_ME@localhost:5432/skilltrack
# Required, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
# Comma-separated explicit origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
COOKIE_SAMESITE=lax
# UPLOAD_DIR=private_uploads   # must NOT be inside a publicly served directory
